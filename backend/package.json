{
  "name": "geoai-backend",
  "version": "1.0.0",
  "description": "Authenticated Node.js inference gateway for the Myanmar Agricultural Model Server",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:import-crop-calendars": "tsx src/db/import-crop-calendars.ts",
    "db:audit-crop-calendars": "tsx src/db/audit-crop-calendars.ts",
    "cleanup:expired-predictions": "tsx src/jobs/cleanupExpiredPredictions.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "eslint .",
    "test:chatbot": "tsx scripts/test_chatbot.ts",
    "validate": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.3",
    "@emnapi/runtime": "2.0.0-alpha.3",
    "@emnapi/wasi-threads": "2.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.21.0",
    "eslint": "^10.8.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
