# Public Node.js gateway
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Separate FastAPI service (runs on port 8001 locally)
MODEL_SERVER_URL=http://127.0.0.1:8001
# Generate a different value for each key, for example: openssl rand -hex 32
MODEL_SERVER_API_KEY=dev-internal-model-key-replace-before-production
MODEL_SERVER_TIMEOUT_MS=40000
MODEL_SERVER_MAX_RESPONSE_BYTES=5242880
MODEL_SERVER_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_SERVER_CIRCUIT_RESET_MS=30000
MODEL_SERVER_CATALOG_CACHE_TTL_MS=30000
MODEL_SERVER_MAX_MATCH_DISTANCE_KM=8
MODEL_SERVER_MAX_IN_FLIGHT=2
# Production requires HTTPS unless this is explicitly enabled for a trusted private network.
ALLOW_INSECURE_MODEL_SERVER_HTTP=false

# Public gateway security. Both keys are mandatory when NODE_ENV=production.
API_KEY=dev-public-gateway-key-replace-before-production
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=65536

# Async Redis jobs are intentionally unavailable in this release.
ENABLE_ASYNC_JOBS=false
