# ==============================================================================
# GeoAI Myanmar Agricultural Backend & Chatbot Configuration
# ==============================================================================
# Copy this file to .env and replace secrets for your local or deployment environment.
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Fastify Server Process & Public Gateway
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Browser / Frontend CORS allowlist (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Rate Limiting & Body Limits
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=65536

# ------------------------------------------------------------------------------
# 2. Authentication & Trust Boundaries (Must be distinct in production)
# ------------------------------------------------------------------------------
# Public API Gateway Key (used by frontend / external clients)
API_KEY=dev-public-gateway-key-replace-before-production

# Internal Pipeline & Ingest Key (used by internal schedulers / weekly pipelines)
INTERNAL_API_KEY=dev-weekly-ingest-key-replace-before-production

# Internal Model Server Key (used for Fastify <-> Python GEO_MODEL_SERVER communication)
GEO_MODEL_SERVER_API_KEY=dev-internal-model-key-replace-before-production

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (Neon / Supabase / Local PostgreSQL)
# ------------------------------------------------------------------------------
# Run `npm run db:migrate` before serving user & market price APIs
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ------------------------------------------------------------------------------
# 4. Google Gemini Agricultural Chatbot for Farmers
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyArmFhVG2d3QHnhrfXkX9zgUyOw5CdFvoI

# Gemini Model Selection (e.g., gemini-2.5-flash, gemini-1.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com

# Chatbot Request Timeout in milliseconds
CHATBOT_REQUEST_TIMEOUT_MS=30000

# Enable Search Grounding for live real-world agricultural facts
CHATBOT_SEARCH_GROUNDING_ENABLED=true

# ------------------------------------------------------------------------------
# 5. GeoAI Model Prediction Server (FastAPI / Python Ensemble)
# ------------------------------------------------------------------------------
GEO_MODEL_SERVER_URL=http://127.0.0.1:8001
MODEL_REQUEST_TIMEOUT_MS=120000
MODEL_SERVER_MAX_RESPONSE_BYTES=5242880
MODEL_SERVER_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_SERVER_CIRCUIT_RESET_MS=30000
MODEL_SERVER_CATALOG_CACHE_TTL_MS=30000
MODEL_SERVER_MAX_MATCH_DISTANCE_KM=8
MODEL_SERVER_MAX_IN_FLIGHT=2
MODEL_BATCH_SIZE=50
MODEL_MAX_CONCURRENT_BATCHES=1
ALLOW_FLAGGED_MODELS=false
ALLOW_INSECURE_MODEL_SERVER_HTTP=false

# ------------------------------------------------------------------------------
# 6. Weekly Pipeline Data & Prediction Retention
# ------------------------------------------------------------------------------
WEEKLY_DATA_DIR=../data/weekly
WEEKLY_RUN_STALE_AFTER_MS=86400000
PREDICTION_RETENTION_DAYS=7
PREDICTION_CLEANUP_INTERVAL_MS=21600000

# ------------------------------------------------------------------------------
# 7. Real-World Market Price Ingest Sources
# ------------------------------------------------------------------------------
MARKET_PRICE_REFRESH_ENABLED=true
MARKET_PRICE_REQUEST_TIMEOUT_MS=120000
MARKET_PRICE_DOA_URL=https://www.doa.gov.mm/mis_market/index.php?filter_category=44&filter_seller=4&route=market%2Fweekly_crop_price_by_seller
MARKET_PRICE_MRF_URL=https://www.myanmarricefederation.org/reference-domestic-price/
MARKET_PRICE_CSO_URL=https://monpifer.gov.mm/en/basic-page/planning/central-statistical-organization-cso/20961
MARKET_PRICE_WISARRA_URL=https://wisarra.com/en/market-price

# ------------------------------------------------------------------------------
# 8. Async Redis Jobs (Optional)
# ------------------------------------------------------------------------------
ENABLE_ASYNC_JOBS=false
