# Browser/web -> public Fastify API. Replace every example key before production.
BACKEND_API_KEY=dev-public-gateway-key-replace-before-production
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_NODE_ENV=development
BACKEND_LOG_LEVEL=info

# PostgreSQL/Neon. Use a least-privilege role and TLS in deployed environments.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Weekly Python pipeline -> trusted Fastify ingest. This key must differ from
# both BACKEND_API_KEY and GEO_MODEL_SERVER_API_KEY.
BACKEND_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=dev-weekly-ingest-key-replace-before-production
BACKEND_REQUEST_TIMEOUT_SECONDS=7200
WEEKLY_DATA_DIR=data/weekly

# Fastify -> separately-run GEO_MODEL_SERVER on host port 8001. The backend
# also accepts the legacy MODEL_SERVER_URL/MODEL_SERVER_API_KEY aliases, but
# new deployments should use these canonical names.
GEO_MODEL_SERVER_URL=http://host.docker.internal:8001
GEO_MODEL_SERVER_API_KEY=dev-internal-model-key-replace-before-production
MODEL_REQUEST_TIMEOUT_MS=120000
MODEL_SERVER_MAX_RESPONSE_BYTES=5242880
MODEL_BATCH_SIZE=50
MODEL_MAX_CONCURRENT_BATCHES=1
ALLOW_FLAGGED_MODELS=false
# Keep false by default. Set true only when a production model URL intentionally
# uses HTTP on a trusted private network.
ALLOW_INSECURE_MODEL_SERVER_HTTP=false

# Weekly regional prediction persistence and cleanup.
WEEKLY_RUN_STALE_AFTER_MS=86400000
PREDICTION_RETENTION_DAYS=7
PREDICTION_CLEANUP_INTERVAL_MS=21600000

# Python reads, but never modifies, these existing aligned model-serving files.
# Or set FEATURES_SERVING_PARQUET and SPATIAL_INDEX_PARQUET independently.
GEO_MODEL_DATA_DIR=../GEO_MODEL_SERVER/data/processed

# Market-price collection is triggered through the authenticated internal
# refresh endpoint by an external daily scheduler.
MARKET_PRICE_REFRESH_ENABLED=true
# One refresh may need every sequential Wisarra result page.
MARKET_PRICE_REQUEST_TIMEOUT_MS=120000
MARKET_PRICE_DOA_URL=https://www.doa.gov.mm/mis_market/index.php?filter_category=44&filter_seller=4&route=market%2Fweekly_crop_price_by_seller
MARKET_PRICE_MRF_URL=https://www.myanmarricefederation.org/reference-domestic-price/
MARKET_PRICE_CSO_URL=https://monpifer.gov.mm/en/basic-page/planning/central-statistical-organization-cso/20961
MARKET_PRICE_WISARRA_URL=https://wisarra.com/en/market-price

# Optional SMS provider secrets; never commit real values.
SMSPOH_API_KEY=
SMSPOH_API_SECRET=
SMSPOH_SENDER_ID=
