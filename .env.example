# Web -> public Node gateway. Leave blank only for local development.
BACKEND_API_KEY=dev-public-gateway-key-replace-before-production
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_NODE_ENV=development
BACKEND_LOG_LEVEL=info

# Node gateway -> separately-run GEO_MODEL_SERVER on host port 8001.
# If GEO_MODEL_SERVER has AUTH_REQUIRED=true, use the same >=24 character value.
MODEL_SERVER_URL=http://host.docker.internal:8001
MODEL_SERVER_API_KEY=dev-internal-model-key-replace-before-production
MODEL_SERVER_TIMEOUT_MS=40000
MODEL_SERVER_MAX_RESPONSE_BYTES=5242880

# Optional SMS provider secrets; never commit real values.
SMSPOH_API_KEY=
SMSPOH_API_SECRET=
SMSPOH_SENDER_ID=