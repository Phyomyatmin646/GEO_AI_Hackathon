# ==============================================================================
# Myanmar Agricultural GeoAI & Farmer Chatbot Full-Stack Environment
# ==============================================================================
# Copy this file to .env and customize secrets for your local environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Gateway & Fastify Server
# ------------------------------------------------------------------------------
BACKEND_URL=http://127.0.0.1:8000
BACKEND_API_KEY=dev-public-gateway-key-replace-before-production
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_NODE_ENV=development
BACKEND_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Authentication & Trust Boundaries
# ------------------------------------------------------------------------------
# Ingest key used by Python weekly pipeline to push results to Fastify
INTERNAL_API_KEY=dev-weekly-ingest-key-replace-before-production

# Fastify <-> Python Model Server internal authentication
GEO_MODEL_SERVER_API_KEY=dev-internal-model-key-replace-before-production

# ------------------------------------------------------------------------------
# 3. PostgreSQL / Neon Database
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ------------------------------------------------------------------------------
# 4. Google Gemini Agricultural Chatbot for Farmers
# ------------------------------------------------------------------------------
# Google AI Studio API Key: https://aistudio.google.com/
GEMINI_API_KEY=ABCDEFGHI_something
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com
CHATBOT_REQUEST_TIMEOUT_MS=30000
CHATBOT_SEARCH_GROUNDING_ENABLED=true

# ------------------------------------------------------------------------------
# 5. GeoAI Model Server (Python FastAPI Ensemble)
# ------------------------------------------------------------------------------
GEO_MODEL_SERVER_URL=http://127.0.0.1:8001
MODEL_REQUEST_TIMEOUT_MS=120000
MODEL_SERVER_MAX_RESPONSE_BYTES=5242880
MODEL_BATCH_SIZE=50
MODEL_MAX_CONCURRENT_BATCHES=1
ALLOW_FLAGGED_MODELS=false
ALLOW_INSECURE_MODEL_SERVER_HTTP=false
GEO_MODEL_DATA_DIR=../GEO_MODEL_SERVER/data/processed

# ------------------------------------------------------------------------------
# 6. Weekly Pipeline Data & Prediction Retention
# ------------------------------------------------------------------------------
WEEKLY_DATA_DIR=data/weekly
BACKEND_REQUEST_TIMEOUT_SECONDS=7200
WEEKLY_RUN_STALE_AFTER_MS=86400000
PREDICTION_RETENTION_DAYS=7
PREDICTION_CLEANUP_INTERVAL_MS=21600000

# ------------------------------------------------------------------------------
# 7. Real-World Market Price Sources
# ------------------------------------------------------------------------------
MARKET_PRICE_REFRESH_ENABLED=true
MARKET_PRICE_REQUEST_TIMEOUT_MS=120000
MARKET_PRICE_DOA_URL=https://www.doa.gov.mm/mis_market/index.php?filter_category=44&filter_seller=4&route=market%2Fweekly_crop_price_by_seller
MARKET_PRICE_MRF_URL=https://www.myanmarricefederation.org/reference-domestic-price/
MARKET_PRICE_CSO_URL=https://monpifer.gov.mm/en/basic-page/planning/central-statistical-organization-cso/20961
MARKET_PRICE_WISARRA_URL=https://wisarra.com/en/market-price

# ------------------------------------------------------------------------------
# 8. Optional SMS Provider (SMSPOH)
# ------------------------------------------------------------------------------
SMSPOH_API_KEY=
SMSPOH_API_SECRET=
SMSPOH_SENDER_ID=
