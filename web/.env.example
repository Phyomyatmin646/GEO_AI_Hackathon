# Server-only connection from the web BFF to the Fastify backend.
BACKEND_URL=http://127.0.0.1:8000
BACKEND_API_KEY=dev-public-gateway-key-replace-before-production

# Loopback HTTP is always accepted. Keep false for public/deployed origins;
# set true only on a trusted private service network.
ALLOW_INSECURE_BACKEND_HTTP=false
